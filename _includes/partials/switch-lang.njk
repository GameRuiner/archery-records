<is-land on:idle>
  <div class="language-select | self-start my-s me-l relative" data-lang-switcher>
    <button
      type="button"
      aria-expanded="false"
      aria-controls="language-items"
      class="language-nav-button icon-center p-xs relative"
      data-sound-pop
    >
      {% svg "misc/globe" %}
      <span class="visually-hidden">{{ translations[page.lang].a11y.navLangAria }}</span>
    </button>

    <ul id="languagenav" class="language-items" role="list">
      {% for lang in ["ua", "en", "pl"] %}
        {% set details = translations[lang] %}
        {%
          set
          translatedUrl = "/" + lang + "/"
        %}
        {%
          set selectedState = "true" if lang == page.lang else
          "false"
        %}

        {% for item in collections.all %}
          {% set currentIsIndoor = page.url.indexOf("/indoor/") > -1 or (page.url.indexOf("/overall/") > -1 and page.url.indexOf("/outdoor/") == -1) %}
          {% set currentIsOutdoor = page.url.indexOf("/outdoor/") > -1 or (page.url.indexOf("/50+/") > -1 and page.url.indexOf("/indoor/") == -1) %}
          {% set itemIsIndoor = item.url.indexOf("/indoor/") > -1 or (item.url.indexOf("/overall/") > -1 and item.url.indexOf("/outdoor/") == -1) %}
          {% set itemIsOutdoor = item.url.indexOf("/outdoor/") > -1 or (item.url.indexOf("/50+/") > -1 and item.url.indexOf("/indoor/") == -1) %}
          {% if translationKey and item.data.translationKey and item.data.translationKey == translationKey and item.data.page.lang == lang and (not currentIsIndoor and not currentIsOutdoor or currentIsIndoor == itemIsIndoor and currentIsOutdoor == itemIsOutdoor) %}
            {% set translatedUrl = item.url %}
          {% endif %}
        {% endfor %}
        <li>
          <a
            id="lang-{{ lang }}"
            href="{{ translatedUrl }}"
            hreflang="{{ lang }}"
            rel="alternate"
            style="--offset: {{ loop.index }}"
            aria-selected="{{ selectedState }}"
            class="button"
            role="option"
          >
            <span lang="{{ lang }}"> {{ details.name }} </span>
          </a>
        </li>
        {% if loop.last %}{% endif %}
      {% endfor %}
    </ul>
  </div>
</is-land>

<script type="module">
  {% include "scripts/is-land.js" %}
  {% include "scripts/lang-select.js" %}
</script>