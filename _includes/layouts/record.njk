---
layout: layouts/base.njk
---
{# Only include the syntax highlighter CSS on blog posts, included with the CSS per-page bundle #}
{%- css %}{% include "node_modules/prismjs/themes/prism-okaidia.css" %}{% endcss %}
{%- css %}{% include "public/css/prism-diff.css" %}{%- endcss %}
{%- css %}{% include "public/css/tables.css" %}{%- endcss %}

{% if eleventyNavigation %}
  {% set currentLang = lang or page.lang or "ua" %}
  {% set breadcrumbs = collections.all | filterByLang(currentLang) | eleventyNavigationBreadcrumb(eleventyNavigation.key) %}
  <ul class="breadcrumbs">
    {% for item in breadcrumbs %}
      <li>
        <a href="{{ item.url }}">{{ item.title }}</a>
      </li>
    {% endfor %}
    <li>{{ title }}</li>
  </ul>
{% endif %}

{% set formatLabels = translations.recordLabels.formats[lang or page.lang or "ua"] or translations.recordLabels.formats.ua %}
{% set currentFormat = "outdoor" if page.url.indexOf("/outdoor/") > -1 or (page.url.indexOf("/50+/") > -1 and page.url.indexOf("/indoor/") == -1) else "indoor" %}
{% set indoorUrl = page.url %}
{% set outdoorUrl = page.url %}
{% if page.url.indexOf("/overall/") > -1 %}
  {% set indoorUrl = page.url | replace("/outdoor/", "/") %}
  {% set outdoorUrl = page.url | replace("/outdoor/", "/") ~ "outdoor/" %}
{% else %}
  {% set indoorUrl = page.url | replace("/indoor/", "/") ~ "indoor/" %}
  {% set outdoorUrl = page.url | replace("/indoor/", "/") %}
{% endif %}
<nav class="format-switcher" aria-label="{{ formatLabels.indoor }} / {{ formatLabels.outdoor }}">
  <a href="{{ indoorUrl }}"{% if currentFormat == "indoor" %} aria-current="page"{% endif %}>{{ formatLabels.indoor }}</a>
  <a href="{{ outdoorUrl }}"{% if currentFormat == "outdoor" %} aria-current="page"{% endif %}>{{ formatLabels.outdoor }}</a>
</nav>

<h1>{{ title }}</h1>

<ul class="post-metadata">
	{# <li><time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time></li> #}
	{%- for tag in tags | filterTagList %}
	{%- set tagUrl %}/tags/{{ tag | slugify }}/{% endset %}
	<li><a href="{{ tagUrl }}" class="post-tag">{{ tag }}</a>{%- if not loop.last %}, {% endif %}</li>
	{%- endfor %}
</ul>

{{ content | safe }}

{# {%- if collections.posts %}
{%- set previousPost = collections.posts | getPreviousCollectionItem %}
{%- set nextPost = collections.posts | getNextCollectionItem %}
{%- if nextPost or previousPost %}
<ul class="links-nextprev">
	{%- if previousPost %}<li class="links-nextprev-prev">← Previous<br> <a href="{{ previousPost.url }}">{{ previousPost.data.title }}</a></li>{% endif %}
	{%- if nextPost %}<li class="links-nextprev-next">Next →<br><a href="{{ nextPost.url }}">{{ nextPost.data.title }}</a></li>{% endif %}
</ul>
{%- endif %}
{%- endif %} #}
